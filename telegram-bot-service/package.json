    "check": "npm run build",
    "set:telegram-webhook": "tsx scripts/set-telegram-webhook.ts"
  },
  "dependencies": {
    "@slack/web-api": "^7.8.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "googleapis": "^150.0.1",
    "openai": "^4.86.1",
    "pg": "^8.13.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
